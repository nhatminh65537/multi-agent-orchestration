# ==============================================================================
# Worker Configuration (.env)
# ==============================================================================

# Worker backend: agy-sdk (default) or claude-sdk
WORKER_BACKEND=agy-sdk

# Worker model (e.g. gemini-3.8-flash-medium, gemini-3.8-flash-high, claude-sonnet-4-5)
WORKER_MODEL=gemini-3.8-flash-medium

# Fallback models used when the primary model is out of quota or fails
# (one model, or several separated by commas)
# WORKER_FALLBACK_MODEL=gemini-2.5-pro,gemini-2.5-flash

# How many seconds a worker may wait for the API quota to recover before retrying
# (default: 900; set 0 to disable waiting)
# WORKER_QUOTA_WAIT_SECONDS=900

# Thinking / effort level: low | medium | high (default: medium)
WORKER_THINKING=medium

# Base URL for a proxy or custom endpoint (leave empty when not needed)
# WORKER_BASE_URL=https://llm.home.rougitsune.top/v1

# Worker API key (Gemini API key, proxy key, or Anthropic API key)
WORKER_API_KEY=your_api_key_here
