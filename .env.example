# ==============================================================================
# Worker Configuration (.env)
# ==============================================================================

# Backend cho worker: agy-sdk (mặc định) hoặc claude-sdk
WORKER_BACKEND=agy-sdk

# Model sử dụng cho worker (ví dụ: gemini-3.8-flash-medium, gemini-3.8-flash-high, claude-sonnet-4-5)
WORKER_MODEL=gemini-3.8-flash-medium

# Mức độ suy luận thinking/effort: low | medium | high (mặc định: medium)
WORKER_THINKING=medium

# Base URL nếu dùng proxy hoặc endpoint custom (nếu không cần thì để trống)
# WORKER_BASE_URL=https://llm.home.rougitsune.top/v1

# API Key cho worker (Gemini API key, proxy key hoặc Anthropic API key)
WORKER_API_KEY=your_api_key_here
